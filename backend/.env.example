# ============================================================
# NKhat — Environment Variables (Production / Render)
# ============================================================
# ضع هذه القيم في Render → Web Service → Environment
# لا تستخدم localhost — الموقع للنشر على الإنترنت فقط
# ============================================================

NODE_ENV=production
# PORT يحدده Render تلقائياً — لا تغيّره

# PostgreSQL — من مزود خارجي (Render Postgres / Railway / Heroku ...)
# Option 1: استخدم DATABASE_URL كاملاً (الأفضل على Render)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option 2: أو استخدم المتغيرات المنفصلة
DB_HOST=your-postgres-host.postgres.com
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=nkhat_store
DB_POOL_SIZE=10
DB_SSL=true

# JWT — سلسلة عشوائية طويلة (32+ حرف)
JWT_SECRET=ضع_هنا_سلسلة_عشوائية_طويلة_جداً
JWT_EXPIRES_IN=8h

# ── حساب الأدمن الوحيد (لا يوجد تسجيل جديد) ───────────────
ADMIN_EMAIL=your-admin@gmail.com
ADMIN_PASSWORD=YourStrongPassword123!

# ── SMTP لإرسال رمز التحقق 2FA ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="NKhat Admin <your-sender@gmail.com>"

# ── CORS — رابط موقعك المنشور على Render ─────────────────
# مثال: https://nkhat.onrender.com
# إذا الواجهة والـ API على نفس الخدمة، ضع نفس الرابط
CORS_ORIGINS=https://your-site.onrender.com

# Cookies — تُفعّل Secure تلقائياً في production
COOKIE_SAME_SITE=lax
